# SHEBA BONDHU — local environment template.
# Copy to `.env` and fill values. NEVER commit `.env` to version control.
# Backend URL is injected into the Flutter app via:
#   flutter run --dart-define=API_BASE_URL=https://api.example.com

# --- Backend (FastAPI) ---------------------------------------------
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://sheba:sheba@localhost:5432/sheba
JWT_SECRET=change-me-please-use-32-bytes-or-more
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# --- LLM / RAG ----------------------------------------------------
LLM_PROVIDER=openai               # openai | anthropic | local
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# --- Firebase (mobile push, analytics) ----------------------------
# Fill these only AFTER Firebase setup is complete. See docs/firebase-setup.md.
FIREBASE_ANDROID_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_PROJECT_ID=

# --- BDAPPS subscription gateway -----------------------------------
# Real values come from bKash / Robi later. Leave blank in dev — the
# app will refuse to call /v1/subscribe and show the "BDAPPS pending" state.
BDAPPS_API_BASE_URL=
BDAPPS_API_KEY=
BDAPPS_PARTNER_ID=

# --- Misc ---------------------------------------------------------
SUBSCRIPTION_DAILY_PRICE_BDT=2
DEMO_MODE=true
PRIVACY_POLICY_URL=https://example.com/privacy
TERMS_URL=https://example.com/terms